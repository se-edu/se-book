@startuml
skinparam shadowing false
skinparam defaultTextAlignment center
skinparam rectangle {
  BackgroundColor #FDFDFD
  BorderColor #333333
  roundCorner 8
}
skinparam node {
  BackgroundColor #F2F6FF
  BorderColor #333333
}
skinparam database {
  BackgroundColor #FDFDFD
  BorderColor #333333
}
skinparam package {
  BackgroundColor transparent
  BorderColor #888888
}
' Must follow skinparam package: PlantUML treats frame as a package-like
' container, so a later package block would otherwise override this.
skinparam frame {
  BackgroundColor #FFFFFF
}
frame "Logical view" {
  rectangle "Ui" as ui
  rectangle "Logic" as logic
  rectangle "Model" as model
  rectangle "RemoteStorage" as rs
  ui ..> logic
  logic ..> model
  logic ..> rs
  rs ..> model
  package "Server" {
    rectangle "Request handler" as rh
    database "Shared data" as db
    rh ..> db
  }
  rs ..> rh
}
frame "Deployment view" {
  node "User A's computer" {
    rectangle "Client" as ca
  }
  node "User B's computer" {
    rectangle "Client " as cb
  }
  node "Server computer" {
    rectangle "Server" as sp
  }
  ca --> sp : request /\nresponse
  cb --> sp : request /\nresponse
}
@enduml
