@startuml
skinparam backgroundColor transparent
skinparam shadowing false
skinparam defaultTextAlignment center
skinparam rectangle {
  BackgroundColor #FDFDFD
  BorderColor #333333
  roundCorner 8
}
top to bottom direction
rectangle "Online bookshop\n<i>(built by a third party)</i>" as shop
rectangle "Merchandise service\n<i>(retail company)</i>" as merch
rectangle "Card charging service\n<i>(bank)</i>" as bank
shop --> merch : browse and\nbuy books
shop --> bank : charge the\ncustomer's card
@enduml
