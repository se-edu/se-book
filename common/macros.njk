{% macro show_aspect(desc) %}
<box type="info" seamless no-icon>

  %%Aspect:%% **{{ desc }}**
</box>
{% endmacro %}
<!-- ============================================================ -->

{% macro show_term(term, definition=0) -%}<span class="badge bg-term-highlight text-body-emphasis">{% if definition %}<popover content="{{ definition }}">++{{ term }}++</popover>{% else %}++{{ term }}++{% endif %}</span>{%- endmacro %}
<!-- ============================================================ -->

{% macro show_gm_lesson_link(lesson_id, lesson_name)%}<md>++<span class="badge rounded-pill bg-gm-link text-success-emphasis">:octicon-git-branch: Git-Mastery → <a href="https://git-mastery.org/lessons/{{ lesson_id }}/" target="_blank">**Lesson {{ lesson_name }}**</a></span>++</md>{% endmacro %}
<!-- ============================================================ -->

{% macro show_gm_tour_link(tour_id, tour_name)%}<md>++<span class="badge rounded-pill bg-gm-link text-success-emphasis">:octicon-git-branch: Git-Mastery → <a href="https://git-mastery.org/lessons/trail/{{ tour_id }}/" target="_blank">**{{ tour_name }}**</a></span>++</md>{% endmacro %}
<!-- ============================================================ -->

{% macro show_example() %}
<cv-toggle xtoggle-id="examples">
<div class="indented-level1 example">

<box type="info" theme="light" seamless no-icon>

  <span style="position: relative; left: -32px; margin-right: -25px; background-color: var(--bs-light-border-subtle);" class="badge rounded-pill fs-6 fw-normal"><md><small>%%:fas-cube: Example%%</small></md></span> {{ caller() | trim }}
</box>
</div>
</cv-toggle>
{% endmacro %}
